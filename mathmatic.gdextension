[configuration]

entry_symbol = "mathmatic_library_init"
compatibility_minimum = 4.2

[libraries]

windows.editor.x86_64 = "res://bin/libmathmatic.windows.editor.x86_64.dll"
windows.debug.x86_64 = "res://bin/libmathmatic.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libmathmatic.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libmathmatic.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmathmatic.linux.template_release.x86_64.so"
macos.debug = "res://bin/libmathmatic.macos.template_debug.framework"
macos.release = "res://bin/libmathmatic.macos.template_release.framework"
